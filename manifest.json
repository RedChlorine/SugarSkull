{
    "manifest_version": 3,
    "name": "SugarSkull",
    "version": "2.0.0",
    "description": "Custom dark mode and UI overhaul for the myUNISA portal.",
    "content_scripts": [
        {
            "matches": [
                "https://www.unisa.ac.za/sites/myunisa/default/*",
                "https://myadmin.unisa.ac.za/login-mymodules/*",
                "https://myadmin.unisa.ac.za/session-widget/*",
                "https://cas.unisa.ac.za/cas/login*",
                "https://mymodules.dtls.unisa.ac.za/login/*"
            ],
            "css": [
                "src/login/login.css"
            ],
            "js": [
                "src/login/login.js"
            ],
            "run_at": "document_start",
            "all_frames": true
        }
    ]
}